{
  "private": true,
  "scripts": {
    "build": "npm explore nodejs-extensions -- pnpm build",
    "build:styles": "npm explore nodejs-extensions -- pnpm build:styles",
    "compile": "npm explore nodejs-extensions -- pnpm compile",
    "lint": "npm explore nodejs-extensions -- pnpm lint",
    "clean": "npm explore nodejs-extensions -- pnpm clean",
    "watch": "npm explore nodejs-extensions -- pnpm watch"
  },
  "nodejsExtensions": {
    "assetsToCopy": [
      {
        "sources": [
          "Assets/Images"
        ],
        "target": "wwwroot/images"
      },
      {
        "sources": [
          "Assets/Fonts"
        ],
        "target": "wwwroot/fonts"
      }
    ],
    "styles": {
      "source": "Assets/Styles",
      "target": "wwwroot/css"
    }
  },
  "dependencies": {
    "bootstrap": "5.3.5",
    "nodejs-extensions": "link:node_modules/.nx"
  },
  "packageManager": "pnpm@10.8.0+sha512.0e82714d1b5b43c74610193cb20734897c1d00de89d0e18420aebc5977fa13d780a9cb05734624e81ebd81cc876cd464794850641c48b9544326b5622ca29971",
  "pnpm": {
    "overrides": {
      "nodejs-extensions": "link:node_modules/.nx"
    }
  },
  "devDependencies": {
    "eslint": "8.47.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.28.1",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-only-warn": "1.1.0",
    "eslint-plugin-promise": "6.1.1"
  }
}
