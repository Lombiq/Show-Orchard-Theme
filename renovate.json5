{
    '$schema': 'https://docs.renovatebot.com/renovate-schema.json',
    'extends': ['github>Lombiq/renovate-config:default-orchard-core-submodule.json5'],
    'prBodyNotes': [
        '@Lombiq/dotnest-sites-renovate-notification-recipients',
    ],
    addLabels: [
        'no-jira-community-activity-issue',
    ],
    packageRules: [
        // We keep ESLint as-is, since Node.js Extensions won't be updated anymore.
        {
            groupName: 'ESLint Updates',
            matchPackageNames: [
                'eslint*',
            ],
            enabled: false,
        },
    ],
}
