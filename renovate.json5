{
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    description: 'Default configuration for Orchard Core-using Git submodules.',
    'extends': ['github>Lombiq/renovate-config:default-orchard-core.json5#issue/NEST-556'],
    packageRules: [
        // In submodules, Lombiq packages only need to be updated during a new release.
        {
            groupName: 'Lombiq packages',
            matchPackageNames: [
                'Lombiq.*',
            ],
            enabled: false,
        },
    ],
}
